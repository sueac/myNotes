# Copy this file to .env.local and fill in your own values.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Web push: generated with `npx web-push generate-vapid-keys`.
# Only the public key goes here. It is safe to ship in the browser.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# The VAPID private key is NOT stored here. Set it as a Supabase secret instead:
#   supabase secrets set VAPID_PRIVATE_KEY=...
